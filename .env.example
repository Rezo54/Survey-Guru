# Survey Guru local development environment template
# Copy to .env.local for local use. Never commit real values.
SURVEY_GURU_ENV=development

# Browser-safe Firebase web configuration (DEV project only)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Survey Guru API (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep escaped newlines when stored in env files: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# Local API origin used by the web API client
NEXT_PUBLIC_SURVEY_GURU_API_URL=http://127.0.0.1:8080

# Optional map integration; connect later when ready
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
