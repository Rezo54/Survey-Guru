{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@survey-guru/domain": ["./packages/domain/src/index.ts"],
      "@survey-guru/capabilities": ["./packages/capabilities/src/index.ts"],
      "@survey-guru/api-client": ["./packages/api-client/src/index.ts"]
    }
  }
}
