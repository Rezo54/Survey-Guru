# Public Firebase Web SDK configuration. Values identify the Firebase project/app;
# they are not Firebase Admin credentials. Do not commit .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public browser key for Google Maps JavaScript API during local development.
# Restrict this key by HTTP referrer and API in Google Cloud. Do not commit .env.local.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Survey Guru API base URL for local development.
NEXT_PUBLIC_SURVEY_GURU_API_URL=http://localhost:8080
