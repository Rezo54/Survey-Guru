# Local Survey Guru API configuration. Never commit credential values.
SURVEY_GURU_ENV=local
HOST=127.0.0.1
PORT=8080

# Server-side Firebase project identifier. Firebase Admin credentials are intentionally
# not part of the first local checkpoint. Protected business endpoints remain disabled
# until server authentication is explicitly configured and tested.
FIREBASE_PROJECT_ID=

# Explicit opt-in development-only road geometry import.
SURVEY_GURU_GEOMETRY_PROJECT_ID=
SURVEY_GURU_DEV_OSM_IMPORT_CONFIRMED=
SURVEY_GURU_DISABLE_COARSE_FIXTURES=false
SURVEY_GURU_MAX_DEV_STREET_SEGMENTS=3000
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
